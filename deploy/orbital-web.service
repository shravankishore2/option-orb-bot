# /etc/systemd/system/orbital-web.service — ORBITAL dashboard (reads CSV/JSON only; never
# calls the broker). Localhost only; Caddy adds HTTPS. Login is the dashboard's own password
# page (auth.py); the password lives only in ~/.orbital_web_password (mode 600).
[Unit]
Description=ORBITAL dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/orbital
Environment=TZ=Asia/Kolkata
Environment=ORBITAL_DASHBOARD_PASSWORD_FILE=/home/ubuntu/.orbital_web_password
# read-only demo link /guest?k=<key>; `python guest.py rotate` writes it (no restart needed)
Environment=ORBITAL_GUEST_KEY_FILE=/home/ubuntu/.orbital_guest_key
# refuse to start without a password rather than serve the dashboard open
Environment=ORBITAL_REQUIRE_LOGIN=1
# trust Caddy's X-Forwarded-Proto (waitress drops untrusted proxy headers by default)
ExecStart=/home/ubuntu/orbital/.venv/bin/waitress-serve --listen=127.0.0.1:5050 --threads=8 \
    --trusted-proxy=127.0.0.1 --trusted-proxy-headers=x-forwarded-proto webapp:app
Restart=always
RestartSec=5
MemoryMax=200M
NoNewPrivileges=yes
PrivateTmp=yes
SyslogIdentifier=orbital-web

[Install]
WantedBy=multi-user.target
