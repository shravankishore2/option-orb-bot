# Append to /etc/caddy/Caddyfile (same header block as the other sites). No basic_auth:
# the dashboard has its own password page and session cookie (auth.py), like QuantRadar.
orbital.68-233-96-25.sslip.io {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	reverse_proxy 127.0.0.1:5050
}
